# Settings for the live site. Copy to /etc/tsi/tsi.env, fill in, and make it
# readable by root only (chmod 600): it holds the passwords.
DJANGO_SETTINGS_MODULE=tsi.settings.production

# A long random string, e.g. from: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

DATABASE_NAME=tsi
DATABASE_USER=tsi
DATABASE_PASSWORD=
DATABASE_HOST=localhost
DATABASE_PORT=5432

STATIC_ROOT=/srv/tsi/static
MEDIA_ROOT=/srv/tsi/media
DOWNLOADS_ROOT=/srv/tsi/app/django/downloads

# Where the admin's own emails link to (password resets and so on)
WAGTAILADMIN_BASE_URL=https://www.tubesupplyinternational.co.uk

# Mail for the contact forms (the messages go to the email address in each
# site's Settings > Site details). With a local mail server (e.g. postfix)
# the defaults work; for an external one:
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# 1 for STARTTLS (usually port 587)
EMAIL_USE_TLS=
DEFAULT_FROM_EMAIL=tubesales@heatextube.co.uk

# Who is emailed when the site has an error (comma separated; may be empty)
ADMIN_EMAILS=
